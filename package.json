{
  "name": "app-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
