    "gray-matter": "^4.0.3",
    "lucide-react": "^1.44.0",
    "mermaid": "^12.0.0",
    "next": "^16.3.4",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.6.0"
  },
  "resolutions": {
    "lodash-es": "4.18.1",
    "workbox-build": "7.4.1",
